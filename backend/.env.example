# ==============================================================================
# MathGPT — Graph-Enhanced RAG Mathematical Learning Platform
# Environment Configuration
# ==============================================================================

# LLM Inference (Groq Cloud) - Get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=llama-3.3-70b-versatile

# Neo4j Graph Database
# Set to your Neo4j Aura or local Bolt instance: bolt://localhost:7687 or neo4j+s://xxxx.databases.neo4j.io
# If left blank or unreachable, the system automatically runs on the built-in resilient in-memory graph store.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Relational Database (for Student Learning Progress & Analytics)
# Default is SQLite for zero-config local run.
# For PostgreSQL: postgresql://username:password@localhost:5432/mathgpt
# For MySQL: mysql+pymysql://username:password@localhost:3306/mathgpt
DATABASE_URL=sqlite:///./math_learning.db

# Embedding Model & FAISS Vector Store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=vector_store
DATA_PATH=data
TOP_K_RESULTS=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# HuggingFace API Key (Optional)
HF_API_KEY=
